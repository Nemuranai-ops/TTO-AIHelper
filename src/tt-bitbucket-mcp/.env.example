# Bitbucket MCP - read-only access to clones already on disk.
# No credentials are needed: this server never contacts Bitbucket.

# Where your clones live. A repo argument may then be a bare folder name.
# Several roots may be joined with ; on Windows, : on macOS/Linux.
BITBUCKET_REPO_ROOT=C:\src\fxaut

# If corpus-mcp already points at the same clones you can leave the line above
# unset and this server will fall back to CORPUS_REPO_ROOT.

# Response size cap, with a visible truncation marker. Default 40000.
#BITBUCKET_MAX_CHARS=40000

# Seconds before a git command is abandoned. Default 120.
#BITBUCKET_GIT_TIMEOUT=120
