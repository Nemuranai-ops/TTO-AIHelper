# Copy to ".env" in this folder and fill in. Never commit the real .env.
# The same API token works for both Jira and Confluence.
# Create one at: https://id.atlassian.com/manage-profile/security/api-tokens

ATLASSIAN_BASE_URL=https://fbdms.atlassian.net
ATLASSIAN_EMAIL=your.name@example.com
ATLASSIAN_API_TOKEN=your_api_token_here

# --- defaults you probably want to leave alone ---
#
# TLS verification is OFF by default, matching pmo-inline. The corporate proxy
# re-signs every certificate with a CA that is not in the system trust store,
# so verification fails with "self-signed certificate in certificate chain".
# Turn it back on only once you have the proxy CA file:
#   REQUESTS_CA_BUNDLE=C:\path\to\mbkproxy-ca.pem
#   ATLASSIAN_VERIFY_TLS=true
#
# Read-only is ON by default: the five create/update/transition tools refuse.
# Set this to false when you actually want to write.
# ATLASSIAN_READ_ONLY=false

# Which Confluence API to use.
#   auto (default) try v2, fall back to v1 automatically and remember the answer
#   v1             pin to /wiki/rest/api/content - the endpoints pmo-inline uses
#   v2             pin to /wiki/api/v2
# ATLASSIAN_CONFLUENCE_API=v1

# --- corporate network ---
# Loopback is ALWAYS excluded from proxying, so the offline tests cannot be
# hijacked by a gateway. HTTP_PROXY/HTTPS_PROXY from your environment are used
# for real Atlassian traffic. Override only if they are not picked up:
# ATLASSIAN_PROXY=http://user:pass@mbkproxy.fxdms.net:8080

# Per-request HTTP timeout in seconds (default 60).
# ATLASSIAN_TIMEOUT=60

# Max characters returned per tool result before truncation (default 40000).
# ATLASSIAN_MAX_CHARS=40000
