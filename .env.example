# TAAS configuration. Copy to .env and fill in. NEVER commit .env.
# X3 ConfigAndSecrets resolves these once at startup and fails naming any missing
# required value.

# --- The two real MCP server scripts (nothing to set - they're vendored) -----
# TAAS drives tt-atlassian-mcp and tt-bitbucket-mcp itself for bulk reads (U2-01) -
# reading 500 issue bodies through the model's context is slow and expensive.
# Both live inside this repo at src/tt-atlassian-mcp and src/tt-bitbucket-mcp, so
# the two lines below already default to the right place - leave them commented
# out unless you're pointing at a different copy. Neither server takes a
# credential from TAAS:
#   tt-bitbucket-mcp reads git clones already on disk. It never contacts
#     Bitbucket at all, so there is no token to give it.
#   tt-atlassian-mcp does call Jira and Confluence, but authenticates from its
#     own .env file next to its script (ATLASSIAN_API_TOKEN) - copy
#     src/tt-atlassian-mcp/.env.example to src/tt-atlassian-mcp/.env and fill
#     that in once, following that project's own README. TAAS never reads it.
#     It also needs `pip install -r src/tt-atlassian-mcp/requirements.txt`
#     (or the equivalent in whatever python3 runs it) before its first real call.
#TAAS_ATLASSIAN_MCP_SCRIPT=src/tt-atlassian-mcp/atlassian_mcp_server.py
#TAAS_BITBUCKET_MCP_SCRIPT=src/tt-bitbucket-mcp/bitbucket_mcp_server.py

# Command to run them with. python3 on macOS/Linux, python on Windows.
TAAS_ATLASSIAN_MCP_COMMAND=python3
TAAS_BITBUCKET_MCP_COMMAND=python3

# Optional: only set these if a server's own .env is NOT next to its script -
# each one already looks there first before falling back to its cwd.
#TAAS_ATLASSIAN_ENV_FILE=
#TAAS_BITBUCKET_ENV_FILE=

# --- Storage (U1-NFR-ENC-01: stays inside the workspace) ---------------------
TAAS_DB_PATH=.taas/taas.db
TAAS_BACKUP_DIR=.taas/backups
TAAS_EXPORT_DIR=generated/exports
TAAS_BACKUP_KEEP=10
TAAS_BUSY_TIMEOUT_MS=5000

# --- Resilience (U1-NFR-REL-02) ----------------------------------------------
TAAS_RETRY_ATTEMPTS=3
TAAS_RETRY_BASE_MS=1000

# --- Scalability (U1-NFR-SCL-03) ---------------------------------------------
TAAS_PAGE_SIZE=200

# --- Business rules. Changing any of these changes the corpus; a change is
# --- recorded in run metadata alongside the results it produced.
TAAS_SIMILARITY_THRESHOLD=0.90
TAAS_COMMIT_LOOKBACK_DAYS=180
TAAS_MAX_BATCH_CASES=200
TAAS_PRIVACY_PATTERNS=email,phone,nino,ssn,card
TAAS_EXTRA_SYNTHETIC_DOMAINS=
TAAS_EXTRA_CREDENTIAL_FIELDS=
TAAS_MAX_CHANGES=500

# --- Generated output locations (U4/U5/U8) -----------------------------------
TAAS_VIEWS_ROOT=generated/testcases
TAAS_AUTOMATION_ROOT=generated/automation
TAAS_REPORTS_ROOT=generated/reports
TAAS_REPORT_FORMATS=markdown,csv

# --- Automation emission (U5). Pinned exactly - a range would make the
# --- generated project non-reproducible across regenerations.
TAAS_PLAYWRIGHT_VERSION=1.49.1
TAAS_TYPESCRIPT_VERSION=5.7.2
TAAS_MAX_SPEC_LINES=5000

# --- Handover verification (U6) ----------------------------------------------
TAAS_COMMAND_TIMEOUT_S=300
TAAS_OUTPUT_LIMIT_BYTES=65536
# Skip the npm/tsc/playwright tier even when Node is present - for an air-gapped
# workstation or a VPN that is down. Produces an honest "skipped" rather than a
# five-minute wait for a timeout.
TAAS_SKIP_TOOLCHAIN=false

# --- Observability -----------------------------------------------------------
TAAS_LOG_LEVEL=INFO
